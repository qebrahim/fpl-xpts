# Copy to .env and fill in. .env is git-ignored; never commit real values.
#
# Nothing in the project needs a secret today: the FPL API is public and the
# site is static. Keys below are placeholders for the planned backend.
#
# Do NOT put secrets in web/.env with a VITE_ prefix: Vite bundles every
# VITE_* variable into the public JavaScript.
#
# In GitHub Actions, use repository secrets (Settings -> Secrets and variables),
# not this file.

# Backend (team builder API, not built yet)
# API_ALLOWED_ORIGIN=https://<user>.github.io
# GCP_PROJECT_ID=

# The Odds API (https://the-odds-api.com): bookmaker odds used to anchor team goals / clean sheets.
# Local runs read it from .env; GitHub Actions reads the repository secret of the same name.
ODDS_API_KEY=
